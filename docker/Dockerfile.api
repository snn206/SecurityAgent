FROM python:3.12-slim

LABEL description="SecurityAgent API Server"

WORKDIR /app

# ── System deps ────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    docker.io \
    curl \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# ── Python deps ────────────────────────────────────────────────────────────
COPY pyproject.toml .
RUN pip install --no-cache-dir -e ".[pdf]" 2>/dev/null || pip install --no-cache-dir uv && uv pip install -e ".[pdf]"

# ── App source ─────────────────────────────────────────────────────────────
COPY src/ ./src/
COPY config/ ./config/
COPY registry/ ./registry/

# ── Runtime ────────────────────────────────────────────────────────────────
ENV SA_PORT=8080
ENV PYTHONPATH=/app/src
EXPOSE 8080

CMD ["uvicorn", "security_agent.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]
