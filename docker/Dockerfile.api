FROM python:3.12-slim

LABEL description="SecurityAgent API Server"

WORKDIR /app

# ── System deps ────────────────────────────────────────────────────────────
RUN apt-get update && apt-get install -y --no-install-recommends \
    docker.io \
    curl \
    libpango-1.0-0 \
    libpangoft2-1.0-0 \
    libharfbuzz0b \
    libfontconfig1 \
    shared-mime-info \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency management
COPY --from=ghcr.io/astral-sh/uv:latest /uv /uvx /bin/

# ── App source & configs ───────────────────────────────────────────────────
COPY pyproject.toml README.md ./
COPY src/ ./src/
COPY config/ ./config/
COPY registry/ ./registry/

# ── Python deps ────────────────────────────────────────────────────────────
RUN uv pip install --system --no-cache .

# ── Runtime ────────────────────────────────────────────────────────────────
ENV SA_PORT=8080
ENV PYTHONPATH=/app/src
EXPOSE 8080

CMD ["uvicorn", "security_agent.api.app:create_app", "--factory", "--host", "0.0.0.0", "--port", "8080"]

