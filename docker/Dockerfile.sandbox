FROM kalilinux/kali-rolling:latest

LABEL maintainer="SecurityAgent" \
      description="SecurityAgent Kali Linux sandbox for isolated tool execution"

# Prevent interactive prompts
ENV DEBIAN_FRONTEND=noninteractive
ENV TERM=xterm-256color

# ── Base packages ──────────────────────────────────────────────────────────
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    # Core utilities
    curl wget git ca-certificates gnupg \
    # Network tools
    nmap netcat-traditional dnsutils whois traceroute iputils-ping \
    # Web tools
    nikto gobuster dirb wfuzz \
    # Exploitation
    sqlmap \
    # Forensics / misc
    binutils file python3 python3-pip \
    # For streaming output
    procps \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/*

# ── Python tools ───────────────────────────────────────────────────────────
RUN pip3 install --no-cache-dir --break-system-packages \
    requests \
    impacket \
    ldap3 || true

# ── Wordlists ──────────────────────────────────────────────────────────────
RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    wordlists \
    && apt-get clean \
    && rm -rf /var/lib/apt/lists/* \
    && gunzip /usr/share/wordlists/rockyou.txt.gz 2>/dev/null || true

# ── Working directory ──────────────────────────────────────────────────────
WORKDIR /workspace
RUN mkdir -p /artifacts /wordlists

# Copy common wordlists to /wordlists
RUN cp /usr/share/wordlists/dirb/common.txt /wordlists/common.txt 2>/dev/null || \
    echo "example.com" > /wordlists/common.txt

# ── Entrypoint ─────────────────────────────────────────────────────────────
RUN printf '#!/bin/bash\nset -e\nmkdir -p /artifacts /workspace\nexec "$@"\n' > /entrypoint.sh \
    && chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["sleep", "infinity"]

