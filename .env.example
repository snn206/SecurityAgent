# ─── Provider API Keys ──────────────────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
MISTRAL_API_KEY=your_mistral_api_key_here
DEEPSEEK_API_KEY=your_deepseek_api_key_here
NVIDIA_NIM_API_KEY=your_nvidia_nim_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
OPENCODE_API_KEY=your_opencode_api_key_here
KILO_API_KEY=your_kilo_api_key_here

# ─── Provider Endpoints (override defaults if needed) ────────────────────────
OLLAMA_BASE_URL=http://localhost:11434
NVIDIA_NIM_BASE_URL=https://integrate.api.nvidia.com/v1
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# ─── API Server ─────────────────────────────────────────────────────────────
SA_HOST=0.0.0.0
SA_PORT=8080
SA_LOG_LEVEL=INFO
SA_DEBUG=false

# ─── Database (Execution History) ───────────────────────────────────────────
# SQLite (default, self-hosted)
SA_DATABASE_URL=sqlite+aiosqlite:///./data/security_agent.db
# PostgreSQL (optional)
# SA_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/security_agent

# ─── Docker Sandbox ──────────────────────────────────────────────────────────
SA_SANDBOX_IMAGE=security-agent-sandbox:latest
SA_SANDBOX_NETWORK=none
SA_SANDBOX_CPU_LIMIT=2
SA_SANDBOX_MEM_LIMIT=2g
SA_SANDBOX_TIMEOUT=300

# ─── Execution & Storage ─────────────────────────────────────────────────────
SA_EXECUTION_MAX_CONCURRENT=5
SA_ARTIFACT_DIR=./data/artifacts
SA_REPORT_DIR=./data/reports

# ─── Security ────────────────────────────────────────────────────────────────
SA_SECRET_KEY=change_me_in_production
SA_CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
